# elasticsearch_username = ""
# elasticsearch_password = ""
# index_name = "utrains-qa"
# embedding_model = "text-embedding-3-small"
# llm_model = "gpt-4o-mini"
# vector_dimension = 1536
# streamlit_port = 8501
